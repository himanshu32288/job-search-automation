# Copy this file to .env and fill in your values.
# RemoteOK is currently public and usually does not require an API key.
REMOTEOK_API_KEY=

# Get a RapidAPI key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional overrides
OUTPUT_FILE=output/jobs.csv
CACHE_TTL_MINUTES=60
RATE_LIMIT_DELAY_MS=1000
USD_TO_INR_RATE=83
