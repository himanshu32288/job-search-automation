# ─────────────────────────────────────────────────────────────
#  Job Search Automation – Environment Variables Template
#  Copy this file to .env and fill in your API keys.
# ─────────────────────────────────────────────────────────────

# ── JSearch (RapidAPI) ──────────────────────────────────────
# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key_here
JSEARCH_API_KEYS=your_optional_second_key, your_optional_third_key
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# ── LinkedIn ────────────────────────────────────────────────
# LinkedIn Jobs API via RapidAPI: https://rapidapi.com/jaypat87/api/linkedin-jobs-search
LINKEDIN_API_KEY=your_linkedin_rapidapi_key_here
LINKEDIN_API_KEYS=your_optional_second_key, your_optional_third_key
LINKEDIN_API_HOST=linkedin-jobs-search.p.rapidapi.com

# ── Indeed ──────────────────────────────────────────────────
# Indeed API via RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/indeed12
INDEED_API_KEY=your_indeed_rapidapi_key_here
INDEED_API_KEYS=your_optional_second_key, your_optional_third_key
INDEED_API_HOST=indeed12.p.rapidapi.com

# ── Glassdoor ───────────────────────────────────────────────
# Glassdoor API via RapidAPI: https://rapidapi.com/Pat92/api/glassdoor
GLASSDOOR_API_KEY=your_glassdoor_rapidapi_key_here
GLASSDOOR_API_KEYS=your_optional_second_key, your_optional_third_key
GLASSDOOR_API_HOST=glassdoor.p.rapidapi.com

# ── Naukri.com ──────────────────────────────────────────────
# Naukri API via RapidAPI: https://rapidapi.com/search?term=naukri
NAUKRI_API_KEY=your_naukri_rapidapi_key_here
NAUKRI_API_KEYS=your_optional_second_key, your_optional_third_key
NAUKRI_API_HOST=naukri-com-jobs.p.rapidapi.com

# ── AngelList / Wellfound ────────────────────────────────────
# AngelList API via RapidAPI: https://rapidapi.com/search?term=angellist
ANGELLIST_API_KEY=your_angellist_rapidapi_key_here
ANGELLIST_API_KEYS=your_optional_second_key, your_optional_third_key
ANGELLIST_API_HOST=angellist-jobs.p.rapidapi.com

# ── Adzuna ──────────────────────────────────────────────────
# Sign up at https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here
ADZUNA_APP_IDS=your_optional_second_app_id, your_optional_third_app_id
ADZUNA_API_KEYS=your_optional_second_key, your_optional_third_key

# ── Proxy (optional) ────────────────────────────────────────
# PROXY_URL=******proxy-host:port
