{
  "output": {
    "file": "output/jobs.csv"
  },
  "filters": {
    "jobType": "Full-time",
    "minimumExperienceYears": 3,
    "minimumSalaryInr": 2000000,
    "maximumSalaryInr": 5000000,
    "allowUnknownSalary": true,
    "allowUnknownExperience": true
  },
  "queryTerms": [
    "Java",
    "Spring Boot",
    "Microservices",
    "Kafka",
    "MongoDB"
  ],
  "skills": {
    "Languages": ["Java", "C++"],
    "Backend & Frameworks": ["Spring Boot", "Spring WebFlux", "Spring Data JPA", "Hibernate"],
    "Distributed Systems": ["Kafka", "RabbitMQ", "Solace", "Event-Driven Architecture", "Microservices"],
    "Databases & Caching": ["Oracle (SQL)", "MongoDB", "Redis", "Aerospike"],
    "System Design": ["Low-Level Design", "High-Level Design", "Design Patterns", "Scalability", "High Availability", "Fault Tolerance"],
    "Tools & Infrastructure": ["Docker", "Kubernetes", "Git", "Grafana"],
    "Best Practices": ["REST API Design", "Unit and Integration Testing", "Data Structures and Algorithms", "OOP"]
  },
  "cache": {
    "file": ".cache/job-search-cache.json",
    "ttlMinutes": 60
  },
  "rateLimit": {
    "delayMs": 1000
  },
  "apis": {
    "remoteOk": {
      "enabled": true,
      "baseUrl": "https://remoteok.com/api"
    },
    "jsearch": {
      "enabled": true,
      "baseUrl": "https://jsearch.p.rapidapi.com/search",
      "host": "jsearch.p.rapidapi.com"
    },
    "githubJobs": {
      "enabled": true,
      "baseUrl": "https://jobs.github.com/positions.json"
    }
  }
}
